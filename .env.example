# 复制成 .env 后填写
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
PORT=7788
ONEBOT_TOKEN=换成一串随机字符串
# QQ 接入端：snowluma（本项目实机验证与推荐）或 napcat（兼容备选）；改完需重启服务。
# SnowLuma 安装：把官方发行包解压到项目下 snowluma/，详见 README。
BIZHI_QQ_PROVIDER=snowluma
# 控制台登录密码（外网访问必须设；没设时外网会拒绝）
CONSOLE_PASSWORD=换成你自己的登录密码
OPEN_BROWSER=0
# 可选：本地台账费率（美元/百万tokens），版本请填写核对日期；未配置仍用旧版估算，不是平台账单。
# BIZHI_PRICING_JSON={"version":"YYYY-MM-DD","usdToCny":"FILL_RATE","models":{"your-model":{"cacheHit":"FILL_PRICE","cacheMiss":"FILL_PRICE","output":"FILL_PRICE"}}}
